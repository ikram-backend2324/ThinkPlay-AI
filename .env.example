# Copy to .env locally if you use a loader, or set these directly in Render's
# environment settings.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# Leave unset locally to fall back to sqlite. On Render, set this to the
# Internal Database URL of a Render Postgres instance.
DATABASE_URL=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: override the model for one specific site language, e.g. if the
# default model's output quality is poor for a low-resource language like
# Karakalpak. Falls back to OPENROUTER_MODEL when left blank.
OPENROUTER_MODEL_EN=
OPENROUTER_MODEL_RU=
OPENROUTER_MODEL_UZ=
OPENROUTER_MODEL_KAA=

# Used by `python manage.py create_default_superuser`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=

# Offline mode (PWA): change this value after a deploy to make every
# browser drop its saved copies of pages and static files.
PWA_CACHE_VERSION=teachx-v1
